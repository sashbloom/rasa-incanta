# Every variable Rasa Incanta reads. Copy to .env (repo root) for local runs; on Railway set
# them in the service's Variables. Never commit real values; only this file is tracked.
# Blank means unset. Secrets fail closed when unset; the notes give the value to use.

# Runtime. ENVIRONMENT: local or production (unset = local).
ENVIRONMENT=
# Unset = sqlite:///./local.db. On Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=
# Unset = Asia/Kolkata
TIMEZONE=

# Our own sign-in. NOT USED while the board is open (api/auth.py keeps the code). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Unset = 12
SESSION_MAX_AGE_HOURS=

# Practus Portal identity handoff (CGO reports standard). NOT USED while the board is open.
PORTAL_IDENTITY_ENABLED=
# Issued by the portal team, one value shared by all reports. Server-side only, never in a
# frontend build. Unset = every portal request is refused.
CGO_REPORTS_API_KEY=

# Frontend build location. Unset = api/static (where npm run build writes it)
STATIC_DIR=

# Frontend dev only (npm run dev). Unset = http://localhost:8000 in dev, the report prefix in builds.
VITE_API_URL=

# Language model (Brick 2). Unset key = cards are built, no NBA is drafted.
ANTHROPIC_API_KEY=
# Unset = claude-sonnet-5
LLM_MODEL_ACTIONS=
# Unset = claude-haiku-4-5-20251001 (mail key points)
LLM_MODEL_EXTRACTION=
# Unset = claude-sonnet-5 (ICP scoring and the Setu re-rank)
LLM_MODEL_ICP=

# ICP scoring. Exa web research; without it those criteria are data gaps.
EXA_API_KEY=
# Unset = 28 (days an ICP result is reused per company)
ICP_CACHE_DAYS=
# Unset = 4 (companies scored in parallel)
ICP_CONCURRENCY=

# Langfuse, the shared Practus project (our tag is rasa-incanta). Unset = tracing off.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Unset = https://cloud.langfuse.com
LANGFUSE_BASEURL=

# Zoho CRM, read-only Postgres copy (Brick 2). Either one connection string, the ICP bot's format:
#   postgresql://<user>:<password>@<host>:5432/zoho_data?sslmode=require   (percent-encode @ in the password as %40)
# or the separate parts below. If both are set, ZOHO_DB_URL wins.
ZOHO_DB_URL=
ZOHO_PG_HOST=
# Unset = 5432
ZOHO_PG_PORT=
# Unset = zoho_data
ZOHO_PG_DATABASE=
ZOHO_PG_USER=
ZOHO_PG_PASSWORD=
# Unset = require (Azure Postgres needs it)
ZOHO_PG_SSLMODE=

# Zoho CRM API through Myrah, read-only. Fallback only if the Postgres copy lacks a field.
# Unset = https://accounts.zoho.in and https://www.zohoapis.in (Myrah's data centre)
ZOHO_ACCOUNTS_URL=
ZOHO_API_DOMAIN=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Read.ai workspace webhook (trigger meeting_end) to POST /api/webhooks/readai. The signing key
# Read.ai issues, raw or base64. Unset = every delivery is refused. READAI_WEBHOOK_SIGNING_KEY also works.
READAI_WEBHOOK_SECRET=

# Outlook through Myrah, Microsoft Graph, read-only (Brick 3)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MYRAH_MAILBOX=
# Delegated sign-in redirect; must be registered on the app. Unset = http://localhost/callback
MS_REDIRECT_URI=

# Setu, read-only Postgres mirror wisible_data (Brick 3). One connection string, or the parts below;
# if both are set, SETU_DB_URL wins.
SETU_DB_URL=
SETU_PGHOST=
# Unset = 5432
SETU_PGPORT=
SETU_PGDATABASE=
SETU_PGUSER=
SETU_PGPASSWORD=
# Unset = require
SETU_PGSSLMODE=
